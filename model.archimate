  <folder name="Technology &amp; Physical" id="id-34ad904978e04cd6aadac96ac8f70136" type="technology">
    <folder name="NORA zones" id="id-f86dd2e94a0b47588cbe59feed2a16fb">
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-12: Test Environment" id="id-032d7845026b49c0bec57ccef9a9be39">
        <property key="ID" value="NORA-12"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="In this zone, systems undergo functional and technical testing to ensure they meet the required specifications. The trust level of this domain is determined by the necessary isolated setup and the restriction that no production data may be processed or stored in this zone."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-1: External" id="id-138d3675b6f541f1aa777d5ec63ea583">
        <property key="ID" value="NORA-1"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="This domain encompasses everything that falls outside the direct protection and management of an organization and should therefore be considered untrusted. Various communication channels to the external world can be established from within an organization: connections to an untrusted zone, a semi-trusted zone, a trusted zone, and a highly trusted zone. For example, if an organization's IT management is entirely outsourced, a highly trusted channel is required to the management service provider. This channel is also needed for exchanging highly confidential information between organizations. Organizations that fully trust each other implement mutual measures and maintain security levels to ensure that only limited border protection is needed at the connection point. Organizations that exchange information at a semi-trusted level also take these measures, requiring limited border protection.&#xA;In summary, the strictness of measures for connecting to untrusted zones mainly focuses on border protection in the communication channel. When connecting trusted zones, the emphasis is primarily on protective measures within the channel itself (the strength of the tunnel)."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-5: Vault" id="id-41180f0a440f4e3e99ceb41baae8e94f">
        <property key="ID" value="NORA-5"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="This zone contains only business information that is crucial for the survival of the organization—these are the &quot;crown jewels&quot; of the organization. Communication with this zone is limited to a select number of systems from the trusted zone, and data exchange is controlled."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-13: Acceptance Environment" id="id-4e800022ef7f4355a0ee7ff7d274d01f">
        <property key="ID" value="NORA-13"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="This domain serves as the &quot;gateway&quot; to the production environment. Here, systems are certified to meet production environment requirements. The trust level is also semi-trusted because no production data may be stored here. The acceptance environment follows similar security measures as the production environment to simulate a realistic business situation."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-7: Portable Media" id="id-4f7c47082d534131a5c40abb9801fad3">
        <property key="ID" value="NORA-7"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="Client devices, depending on their type, are equipped with DVD/CD-ROM drives, memory slots, USB interfaces, and wireless network interfaces such as Wi-Fi and Bluetooth. This domain is considered untrusted because, with the exception of encrypted USB sticks issued by the organization, these devices do not fall under the organization's management. To prevent malicious code from entering the client environment via these media, policy rules dictate that these interfaces are either restricted or disabled, and all data transferred between clients and portable media is inspected."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-10: Experimental Environment" id="id-6c752dcf3f11407497adfcd05514b9bc">
        <property key="ID" value="NORA-10"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="This zone is a laboratory environment that is physically separated from other environments. Due to the experimental nature of IT resources and work processes within this environment (also referred to as a laboratory), this is classified as an untrusted domain."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-4: Back Office" id="id-ace1ea2f04a348e9a87b53971289b9af">
        <property key="ID" value="NORA-4"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="This zone contains both supporting systems for the front office and systems used to populate business-critical systems located in the data zone. The back office is a trusted domain where applications essential for the organization's normal business operations run."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-2: DMZ (Demilitarized Zone)" id="id-b0227fd63d86473fa09c8940ef850180">
        <property key="ID" value="NORA-2"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="This domain is a neutral area between the external world and the organization, primarily serving as a relay. The external side of a DMZ is formed by border protection with strong filtering functions. Within the DMZ, mechanisms exist for protocol filtering and blocking unwanted communications, as well as functionalities for decoupling (proxies), protocol transformation, hacker deception, and monitoring.&#xA;In many cases, the DMZ also contains web servers that hold publicly accessible organizational data. The security level is semi-trusted because the data in a DMZ must, in the worst case, be considered disposable. If the external border protection is breached, a hacker could gain access to the data within the DMZ. The filtering mechanisms and the border protection between the DMZ and the organization must prevent hackers from progressing from the DMZ to trusted domains."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-9: Audit" id="id-d6c9345d4ac1493da869eee833374bf2">
        <property key="ID" value="NORA-9"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="This zone is used to separate monitoring and verification functions from operational management tasks. Audit information from log files must not be modified or altered unnoticed by administrators or end users. Audit-related information is aggregated and securely stored in the audit zone, and it does not leave this zone in its original form via the network."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-8: Management" id="id-e4e73555f2f94249baf411f273e9d796">
        <property key="ID" value="NORA-8"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="This zone is highly trusted, as administrators with elevated privileges must be able to perform their tasks securely. Access to administrative clients is segregated from regular office tasks, which can be performed from internal client systems. Through role separation and technical measures, administrative tasks are strictly isolated from auditing activities. Management functions performed via remote management clients or internal clients have restricted privileges compared to those available within the organization’s management zone."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-6: Client" id="id-f2482a5e04ef4f288a344d1813127ca5">
        <property key="ID" value="NORA-6"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="This zone encompasses the office environment, including end-user workstation equipment, LAN networks, and network printers within an organization. This end-user system environment is referred to as the &quot;client.&quot; This domain is classified as semi-trusted due to the large number of connections and its relatively high vulnerability to breaches. Security policy compliance in this &quot;office domain&quot; is typically limited. If organizations allow employees to work within an office environment using systems in the development, test, acceptance, or management zones, additional measures must be implemented to ensure the required logical separation and segregation of duties for security levels. These measures include both technical and organizational controls."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-11: Development Environment" id="id-f6dc4f53c7f94fd7a024562fa3d853b2">
        <property key="ID" value="NORA-11"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="In this zone, new products are developed and tested, or systems are isolated pending approval for deployment in the organization's production environment. The development domain is classified as semi-trusted, as it requires the use of utilities and tools that are either restricted or not permitted in production environments."/>
      </element>
      <element xsi:type="archimate:CommunicationNetwork" name="NORA-3: Front Office" id="id-ff2415fad8794bc8a73c1da363c76e40">
        <property key="ID" value="NORA-3"/>
        <property key="Latest Sync Date" value="11/05/25 15:12:20"/>
        <property key="Description" value="The front office of an organization is a trusted zone. It contains systems oriented towards the external world, such as web servers. The front office includes both informational web servers and web servers that facilitate user transactions to the back office. From the customer's perspective, the front office functions as a &quot;gateway,&quot; where customer information is processed into organizational information and vice versa. The interface between the front and back office operates as a network or a &quot;service bus&quot; where back-office information is made available. The front office is classified as a trusted domain."/>
      </element>
    </folder>
    <folder name="Technology services" id="id-34908b3ff6764761ab23f36e77940e24">
      <folder name="Removed" id="id-30ed507e071742fcad9a426a21eeae5d">
        <element xsi:type="archimate:TechnologyService" name="STS-26: Asset management service" id="id-23902383279f4c2e84ff9e26bada660a">
          <documentation>Removed as it is not a security service - we depend on it.</documentation>
          <property key="ID" value="STS-26"/>
