        <property key="Original ID" value="TE-27"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="SP-TE-29: Web application attacks or code injection attack" id="id-36afb9878ae443a29d336a79bb5135eb">
        <documentation>Trusted applications or services are compromised through web application attacks or code injection attack</documentation>
        <property key="ID" value="SP-TE-29"/>
        <property key="Latest Sync Date" value="11/05/25 14:39:00"/>
        <property key="Original ID" value="TE-29"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="SP-TE-41: Brute force attempts on user or system accounts" id="id-412a258b787a418db3649b5e03c3ce21">
