        <documentation>Exhaustion of underlying hosting platform memory or computing resources</documentation>
        <property key="ID" value="SP-TE-42"/>
        <property key="Latest Sync Date" value="11/05/25 14:39:00"/>
        <property key="Original ID" value="TE-42"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="SP-TE-15: Unintentional damages through security testing" id="id-4d0887575fd14a2ba909041de4618e7a">
        <documentation>Loss of confidence in the stability or integrity of application, system or services due to security testing or attempted exploitation of vulnerabilities</documentation>
        <property key="ID" value="SP-TE-15"/>
        <property key="Latest Sync Date" value="11/05/25 14:39:00"/>
        <property key="Original ID" value="TE-15"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="SP-TE-09: Accidental leaks or sharing of information due to human error or mishandling" id="id-4da7de02bec2418eb83bb4626f72cc0e">
