      <element xsi:type="archimate:BusinessEvent" name="SP-TE-32: Social engineering or phishing attacks" id="id-023d512ead5a41e9b60ca1c06064cd23">
        <documentation>Adversary counterfeits communications from a legitimate or trustworthy source with the intent of persuading or tricking individuals to expose sensitive information</documentation>
        <property key="ID" value="SP-TE-32"/>
        <property key="Latest Sync Date" value="11/05/25 14:39:00"/>
        <property key="Original ID" value="TE-32"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="SP-TE-20: Interception of information due to publicly accessible insecure or rouge remote access points" id="id-02ef3b966d654d8cb7de46ab92990a9e">
        <documentation>Gain unauthorised access into information systems via rouge or misconfigured network services such as WIFI, VPN or Remote Desktop services</documentation>
        <property key="ID" value="SP-TE-20"/>
        <property key="Latest Sync Date" value="11/05/25 14:39:00"/>
        <property key="Original ID" value="TE-20"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="SP-TE-35: Lack of security insights, monitoring or manipulation of audit log integrity" id="id-087333a1214a4cc7b5cd149de5360dca">
        <documentation>Manipulation of audit event data or inability to capture and audit actions, events or activities. This effects both integrity and non-repudiation of actions and events within information systems.</documentation>
        <property key="ID" value="SP-TE-35"/>
        <property key="Latest Sync Date" value="11/05/25 14:39:00"/>
        <property key="Original ID" value="TE-35"/>
      </element>
