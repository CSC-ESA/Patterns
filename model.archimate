            <sourceConnection xsi:type="archimate:Connection" id="id-3975c156b53a4cf5ba6a499a43b83d85" lineColor="#c0c0c0" source="id-a3d0714ca41c4041944a1f675b0a0311" target="id-13d1dfddf1314619a62038fd402b9e9a" archimateRelationship="id-a080e4310dd74bf8aa747e768037edb8">
