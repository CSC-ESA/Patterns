        <documentation>Utilise information systems or networks infrastructure to collect or sniff network traffic</documentation>
        <property key="ID" value="SP-TE-21"/>
        <property key="Latest Sync Date" value="11/05/25 14:39:00"/>
        <property key="Original ID" value="TE-21"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="SP-TE-19: Failure within information systems due to disruption or unavailability of dependant external supply chains" id="id-bb3a1fbcfee14a45b22c147eb7ec399d">
