          <property key="Status" value="Removed"/>
        </element>
        <element xsi:type="archimate:TechnologyService" name="STS-34: Virtualized desktop infrastructure service" id="id-073714280b424219a6276af26823b394">
          <documentation>Removed as it is not a security service (even though it serves some security controls). </documentation>
          <property key="ID" value="STS-34"/>
          <property key="Latest Sync Date" value="03/04/26 07:05:04"/>
          <property key="Status" value="Removed"/>
        </element>
        <element xsi:type="archimate:TechnologyService" name="STS-24: Zero trust network access" id="id-7ffe94f9ed9049bb98487a228f55045a">
          <documentation>Removed in favor of BB-25</documentation>
          <property key="ID" value="STS-24"/>
          <property key="Latest Sync Date" value="03/04/26 07:05:04"/>
          <property key="Status" value="Removed"/>
        </element>
      </folder>
      <element xsi:type="archimate:TechnologyService" name="STS-01: Data loss prevention service  " id="id-7e32ce388e4e448196671e1cfa37e653">
        <documentation>Prevents unauthorized sharing or leakage of sensitive information.</documentation>
        <property key="ID" value="STS-01"/>
        <property key="Latest Sync Date" value="03/04/26 07:05:04"/>
        <property key="Status" value="Proposed"/>
      </element>
      <element xsi:type="archimate:TechnologyService" name="STS-02: Identity governance and administration service  " id="id-0f8ec1c611364abd9788d655adb3154a">
        <documentation>Manages user identities, roles, and access rights across systems.</documentation>
        <property key="ID" value="STS-02"/>
        <property key="Latest Sync Date" value="03/04/26 07:05:04"/>
        <property key="Status" value="Proposed"/>
      </element>
      <element xsi:type="archimate:TechnologyService" name="STS-03: Identity provider service  " id="id-b794b771aa8f46afb7d43e99069d38ec">
        <documentation>Authenticates users and provides single sign-on to applications.</documentation>
        <property key="ID" value="STS-03"/>
        <property key="Latest Sync Date" value="03/04/26 07:05:04"/>
        <property key="Status" value="Proposed"/>
      </element>
      <element xsi:type="archimate:TechnologyService" name="STS-04: Security testing service  " id="id-1a9ccf79dacd4f179c3a8ab65eab8018">
        <documentation>Analyzes application source code to detect security weaknesses.</documentation>
        <property key="ID" value="STS-04"/>
        <property key="Latest Sync Date" value="03/04/26 07:05:04"/>
        <property key="Status" value="Proposed"/>
      </element>
      <element xsi:type="archimate:TechnologyService" name="STS-05: Network firewall service  " id="id-cc17a21963bb4ebdbffae74066c08108">
        <documentation>Controls and filters network traffic based on security rules. Used for devices that filter up to layer 4 in the ISO OSI model. </documentation>
        <property key="ID" value="STS-05"/>
        <property key="Latest Sync Date" value="03/04/26 07:05:04"/>
        <property key="Status" value="Proposed"/>
      </element>
      <element xsi:type="archimate:TechnologyService" name="STS-06: Endpoint detection and response service  " id="id-9510dcb19a4542f2accd15000e513306">
        <documentation>Monitors and responds to threats on user devices.</documentation>
        <property key="ID" value="STS-06"/>
        <property key="Latest Sync Date" value="03/04/26 07:05:04"/>
