        <documentation>Exfiltration of critical or sensitive information resulting in data breach</documentation>
        <property key="ID" value="SP-TE-37"/>
        <property key="Latest Sync Date" value="11/05/25 14:39:00"/>
        <property key="Original ID" value="TE-37"/>
