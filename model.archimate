        <documentation>Exploit of poorly configured information systems to conduct unauthorized activities or configuration changes</documentation>
        <property key="ID" value="SP-TE-26"/>
        <property key="Latest Sync Date" value="11/05/25 14:39:00"/>
        <property key="Original ID" value="TE-26"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="SP-TE-04: Sabotage" id="id-113a903295f84f0db0e7858d90caf1cc">
        <documentation>Individual(s) engaged in Deceptive or deceitful behaviour against another person or organisation to suffer some disadvantage</documentation>
        <property key="ID" value="SP-TE-04"/>
        <property key="Latest Sync Date" value="11/05/25 14:39:00"/>
        <property key="Original ID" value="TE-04"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="SP-TE-05: Physical theft" id="id-151b6b201da74a09a44070d86892761b">
